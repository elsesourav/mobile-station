# ==============================================================================
# MOBILE STATION — Root Monorepo & Separated APIs Reference (.env.example)
# ==============================================================================
# STRICT ISOLATION RULE:
# Every API, database, bucket, media cloud, search index, and payment merchant
# here MUST be completely separate from GLOROV or any other project.
# Never commit real `.env` files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRANSACTIONAL RELATIONAL DATABASE API (PostgreSQL 16 / Supabase / Neon)
# ------------------------------------------------------------------------------
# Purpose: Orders, catalog, inventory, variants, GST records, IMEI/serial warranty ledger.
DB_USER=ms_postgres
DB_PASSWORD=replace-with-strong-db-password-min-16-chars
DB_NAME=mobile_station_medusa
DB_HOST_PORT=5434
# Local Docker: postgresql://ms_postgres:ms_dev_postgres_password@localhost:5434/mobile_station_medusa
# Managed (Supabase Session Pooler / Neon Direct): MUST use port 5432 (not 6543) with sslmode=require
DATABASE_URL=postgresql://ms_postgres:replace-with-strong-db-password-min-16-chars@localhost:5434/mobile_station_medusa
DB_POOL_MIN=2
DB_POOL_MAX=10

# ------------------------------------------------------------------------------
# 2. IN-MEMORY CACHE, WORKFLOW QUEUE & RATE-LIMIT API (Redis 7 / Upstash)
# ------------------------------------------------------------------------------
# Purpose: Medusa Event Bus, BullMQ background jobs, pincode rate cache, cart/rate-limit state.
REDIS_HOST_PORT=6380
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://localhost:6380

# ------------------------------------------------------------------------------
# 3. PUBLIC MEDIA & IMAGE OPTIMIZATION CDN API (Dedicated Cloudinary Account)
# ------------------------------------------------------------------------------
# Purpose: Product photography, category tiles, hero banners, AVIF/WebP transforms ONLY.
# MUST be a separate Cloudinary Cloud Name / Folder (`mobile-station`) from GLOROV.
CLOUDINARY_CLOUD_NAME=your_mobile_station_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_mobile_station_cloudinary_api_key
CLOUDINARY_API_SECRET=your_mobile_station_cloudinary_api_secret
CLOUDINARY_FOLDER=mobile-station
CLOUDINARY_UPLOAD_PRESET=mobile_station_signed

# ------------------------------------------------------------------------------
# 4. PRIVATE OBJECT & DOCUMENT STORAGE API (Cloudflare R2 / AWS S3 / MinIO)
# ------------------------------------------------------------------------------
# Purpose: SEPARATE from Cloudinary & PostgreSQL! Stores private/non-image files:
#   - Generated GST Tax Invoice PDFs (with IMEI/Serial numbers)
#   - Brand Warranty Cards & Return Unboxing Proof Videos
#   - Bulk CSV Catalog Imports & PostgreSQL Automated Backups
STORAGE_S3_PROVIDER=r2 # r2 | s3 | minio | supabase-s3
STORAGE_S3_ENDPOINT=http://localhost:9100
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=mobile-station-private
STORAGE_S3_ACCESS_KEY_ID=ms_minio_admin
STORAGE_S3_SECRET_ACCESS_KEY=ms_minio_secret_12345
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_PRESIGNED_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 5. FULL-TEXT & TECHNICAL SPECS SEARCH API (Meilisearch)
# ------------------------------------------------------------------------------
# Purpose: Instant typo-tolerant search & dynamic faceted filters (RAM, SSD, 5G, Wattage, Switch).
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=ms_dev_meilisearch_master_key_32chars
MEILISEARCH_INDEX_PREFIX=mobile_station_

# ------------------------------------------------------------------------------
# 6. MEDUSA BACKEND CORE & CORS
# ------------------------------------------------------------------------------
PORT=9000
NODE_ENV=development
MEDUSA_BACKEND_URL=http://localhost:9000
JWT_SECRET=replace-with-32-byte-hex-secret-openssl-rand-hex-32
COOKIE_SECRET=replace-with-32-byte-hex-secret-openssl-rand-hex-32
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000

# ------------------------------------------------------------------------------
# 7. INDIAN PAYMENTS & AFFORDABILITY EMI GATEWAY API (Razorpay)
# ------------------------------------------------------------------------------
# Purpose: UPI, Cards, NetBanking, No-Cost EMI & Affordability Widget.
RAZORPAY_KEY_ID=rzp_test_mobile_station_key_id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
RAZORPAY_MOCK_MODE=true
COD_MAX_AMOUNT_PAISE=1000000 # ₹10,000 COD safeguard cap for electronics

# ------------------------------------------------------------------------------
# 8. LOGISTICS, PINCODE & OPEN-BOX DELIVERY API (Shiprocket)
# ------------------------------------------------------------------------------
SHIPROCKET_EMAIL=logistics@mobilestation.in
SHIPROCKET_PASSWORD=replace-with-shiprocket-password
SHIPROCKET_WEBHOOK_TOKEN=replace-with-shiprocket-webhook-token
SHIPROCKET_PICKUP_LOCATION="Mobile Station Muzaffarpur Hub"
SHIPROCKET_PICKUP_PINCODE="842001"
SHIPROCKET_HIGH_VALUE_INSURANCE_THRESHOLD_PAISE=2500000 # Insure & require OBD >= ₹25,000
SHIPROCKET_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL API (Resend or AWS SES SMTP)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend # resend | smtp
RESEND_API_KEY=re_replace_with_mobile_station_resend_key
NOTIFICATION_FROM_EMAIL=orders@mobilestation.in
NOTIFICATION_FROM_NAME="Mobile Station"
NOTIFICATION_REPLY_TO=support@mobilestation.in
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 10. SMS & WHATSAPP OTP / COD VERIFICATION API (MSG91 / Gupshup)
# ------------------------------------------------------------------------------
# Purpose: High-value electronics COD OTP confirmation, Open-Box Delivery alerts.
SMS_PROVIDER=msg91 # msg91 | twilio | mock
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_SENDER_ID=MOBSTN
MSG91_OTP_TEMPLATE_ID=replace-with-dlt-template-id
WHATSAPP_PROVIDER_TOKEN=replace-with-whatsapp-provider-token
SMS_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 11. B2B GSTIN VERIFICATION API (Optional for Corporate ITC Invoices)
# ------------------------------------------------------------------------------
GSTIN_VERIFICATION_PROVIDER=sandbox # sandbox | cashfree | clear | mock
GSTIN_API_KEY=replace-with-gstin-api-key
GSTIN_API_SECRET=replace-with-gstin-api-secret
GSTIN_MOCK_MODE=true

# ------------------------------------------------------------------------------
# 12. OBSERVABILITY, ERROR TRACKING & STOREFRONT PUBLIC KEYS
# ------------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_replace_after_backend_seed
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mobile Station"
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mobile_station_key_id
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=ms_dev_search_only_key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_mobile_station_cloudinary_cloud_name

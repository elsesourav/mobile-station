# ==============================================================================
# MOBILE STATION — Backend Environment Configuration Example (apps/backend/.env)
# ==============================================================================
# Copy to `apps/backend/.env` for local or production runtime.
# NEVER put storefront-only NEXT_PUBLIC_* vars here or commit real secrets.
# ==============================================================================

PORT=9000
NODE_ENV=development
MEDUSA_BACKEND_URL=http://localhost:9000

# 1. Relational Database (PostgreSQL 16 — Separate from GLOROV)
DATABASE_URL=postgresql://ms_postgres:ms_dev_postgres_password@localhost:5434/mobile_station_medusa
DB_POOL_MIN=2
DB_POOL_MAX=10

# 2. Cache, Event Bus & Rate Limits (Redis 7 — Separate from GLOROV)
REDIS_URL=redis://localhost:6380

# 3. Cryptographic Secrets (openssl rand -hex 32)
JWT_SECRET=replace-with-32-byte-hex-jwt-secret-mobile-station
COOKIE_SECRET=replace-with-32-byte-hex-cookie-secret-mobile-station

# 4. CORS Origins (No "*" in production)
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000

# 5. Public Image CDN API (Dedicated Cloudinary Account)
CLOUDINARY_CLOUD_NAME=your_mobile_station_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_mobile_station_cloudinary_api_key
CLOUDINARY_API_SECRET=your_mobile_station_cloudinary_api_secret
CLOUDINARY_FOLDER=mobile-station

# 6. Private Object & Document Storage API (Cloudflare R2 / AWS S3 / MinIO)
# Stores GST tax invoice PDFs, warranty cards, CSV imports, and DB backups.
STORAGE_S3_PROVIDER=minio
STORAGE_S3_ENDPOINT=http://localhost:9100
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=mobile-station-private
STORAGE_S3_ACCESS_KEY_ID=ms_minio_admin
STORAGE_S3_SECRET_ACCESS_KEY=ms_minio_secret_12345
STORAGE_PRESIGNED_TTL_SECONDS=900

# 7. Instant Search & Faceted Specs Engine (Meilisearch)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=ms_dev_meilisearch_master_key_32chars
MEILISEARCH_INDEX_PREFIX=mobile_station_

# 8. Payments & EMI (Razorpay + Capped COD)
RAZORPAY_KEY_ID=rzp_test_mobile_station_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
RAZORPAY_MOCK_MODE=true
COD_MAX_AMOUNT_PAISE=1000000

# 9. Logistics & High-Value Shipping (Shiprocket)
SHIPROCKET_EMAIL=logistics@mobilestation.in
SHIPROCKET_PASSWORD=replace_with_shiprocket_password
SHIPROCKET_WEBHOOK_TOKEN=replace_with_shiprocket_webhook_token
SHIPROCKET_PICKUP_LOCATION="Mobile Station Muzaffarpur Hub"
SHIPROCKET_PICKUP_PINCODE="842001"
SHIPROCKET_HIGH_VALUE_INSURANCE_THRESHOLD_PAISE=2500000
SHIPROCKET_MOCK_MODE=true

# 10. Email (Resend or SMTP) & SMS/WhatsApp OTP (MSG91)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_resend_key
NOTIFICATION_FROM_EMAIL=orders@mobilestation.in
NOTIFICATION_FROM_NAME="Mobile Station"
NOTIFICATION_REPLY_TO=support@mobilestation.in
NOTIFICATION_MOCK_MODE=true

SMS_PROVIDER=msg91
MSG91_AUTH_KEY=replace_with_msg91_auth_key
MSG91_SENDER_ID=MOBSTN
MSG91_OTP_TEMPLATE_ID=replace_with_dlt_template_id
SMS_MOCK_MODE=true

# 11. B2B GSTIN Lookup API & Observability
GSTIN_VERIFICATION_PROVIDER=mock
GSTIN_API_KEY=
GSTIN_API_SECRET=
GSTIN_MOCK_MODE=true
SENTRY_DSN=
LOG_LEVEL=info

  "devDependencies": {
    "@medusajs/eslint-plugin": "2.22.0",
    "@medusajs/test-utils": "2.22.0",
    "@mobile-station/config": "workspace:*",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",

{
  "name": "@mobile-station/backend",
  "version": "0.1.0",
  "description": "Mobile Station Commerce Backend — Medusa v2 Modular Engine",
  "author": "Mobile Station Engineering",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "medusa db:migrate --skip-search --execute-safe-links",
    "db:create": "medusa db:create",
    "user": "medusa user",
    "test": "pnpm test:unit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "@aws-sdk/s3-request-presigner": "^3.1177.0",

    "@medusajs/caching": "2.22.0",
    "@medusajs/cli": "2.22.0",
    "@medusajs/dashboard": "2.22.0",
    "@medusajs/draft-order": "2.22.0",
    "@medusajs/framework": "2.22.0",
    "@medusajs/medusa": "2.22.0",
    "@medusajs/ui": "4.2.6",
    "@mobile-station/brand": "workspace:*",
    "@mobile-station/types": "workspace:*",
    "@sentry/node": "^11.17.0",
    "cloudinary": "^2.11.0",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.63.0",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",

# ==============================================================================
# MOBILE STATION — Storefront Environment Configuration Example (.env.local)
# ==============================================================================
# Copy to `apps/storefront/.env.local`.
# Only NEXT_PUBLIC_* variables are exposed to client browsers.
# NEVER put DB strings, S3 secrets, Cloudinary secrets, or Razorpay secrets here.
# ==============================================================================

# Commerce Backend API (Medusa v2)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_replace_after_backend_seed

# Canonical Storefront Origin & Branding
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Mobile Station"
NEXT_PUBLIC_DEFAULT_REGION=in
NEXT_PUBLIC_DEFAULT_CURRENCY=inr

# Public Image CDN Cloud Name (for client responsive Cloudinary URL builder)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_mobile_station_cloudinary_cloud_name

# Instant Search Public Search-Only Key (Meilisearch)
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=ms_dev_search_only_key

# Razorpay Public Key ID (for Razorpay Checkout & Affordability EMI Widget)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mobile_station_key_id

# Observability & Support
NEXT_PUBLIC_WHATSAPP_NUMBER=919900000000
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
CDN_URL=

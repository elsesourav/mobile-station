{
  "name": "@mobile-station/storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile Station Web Storefront — Next.js 15 App Router",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:cf": "opennextjs-cloudflare build",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mobile-station/brand": "workspace:*",
    "@mobile-station/types": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.19",
    "@sentry/nextjs": "^11.17.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mobile-station/config": "workspace:*",
    "@types/node": "^20.12.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0",
    "wrangler": "^4.169.0"
  },
  "engines": {
    "node": ">=20.0.0 <=24.x"
  }
}
